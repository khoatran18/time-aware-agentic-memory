   "track": "location",
   "phase": "point",
   "kind": "change",
   "subject": "self",
   "object": "Vologda Viceroyalty",
   "quote": "In 1780, Archangelgorod Governorate, with the center in Arkhangelsk, was abolished and transformed to Vologda Viceroyalty.",
   "section": 2,
   "flags": [],
   "cid": "/wiki/Vologda_Governorate#7"
  },
  {
