[{"id": "London_Fire_Brigade|0|7", "i": 0, "j": 7, "verdict": "same", "a": {"date": "1865", "phase": "point", "track": "other", "section": 0, "text": "The London Fire Brigade was formed by the Metropolitan Fire Brigade Act 1865."}, "b": {"date": "1865", "phase": "point", "track": "other", "section": 1, "text": "The Metropolitan Fire Brigade Act was passed."}}, {"id": "London_Fire_Brigade|0|8", "i": 0, "j": 8, "verdict": "same", "a": {"date": "1865", "phase": "point", "track": "other", "section": 0, "text": "The London Fire Brigade was formed by the Metropolitan Fire Brigade Act 1865."}, "b": {"date": "1865", "phase": "point", "track": "other", "section": 1, "text": "The Metropolitan Fire Brigade was created under the leadership of Eyre Massey Shaw."}}, {"id": "London_Fire_Brigade|7|8", "i": 7, "j": 8, "verdict": "same", "a": {"date": "1865", "phase": "point", "track": "other", "section": 1, "text": "The Metropolitan Fire Brigade Act was passed."}, "b": {"date": "1865", "phase": "point", "track": "other", "section": 1, "text": "The Metropolitan Fire Brigade was created under the leadership of Eyre Massey Shaw."}}, {"id": "London_Fire_Brigade|13|121", "i": 13, "j": 121, "verdict": "same", "a": {"date": "1965", "phase": "point", "track": "affiliation", "section": 1, "text": "With the formation of Greater London, the brigade absorbed most of the Middlesex Fire Brigade and other brigades."}, "b": {"date": "1965", "phase": "point", "track": "other", "section": 17, "text": "The creation of the Greater London Council saw the number of LFB stations increase."}}, {"id": "London_Fire_Brigade|13|122", "i": 13, "j": 122, "verdict": "same", "a": {"date": "1965", "phase": "point", "track": "affiliation", "section": 1, "text": "With the formation of Greater London, the brigade absorbed most of the Middlesex Fire Brigade and other brigades."}, "b": {"date": "1965", "phase": "point", "track": "affiliation", "section": 17, "text": "The LFB absorbed some stations from the county brigades."}}, {"id": "London_Fire_Brigade|14|15", "i": 14, "j": 15, "verdict": "different", "a": {"date": "1986", "phase": "point", "track": "other", "section": 1, "text": "The Greater London Council was disbanded."}, "b": {"date": "1986", "phase": "point", "track": "ownership_structure", "section": 1, "text": "The London Fire and Civil Defence Authority was formed to take responsibility for the LFB."}}, {"id": "London_Fire_Brigade|15|99", "i": 15, "j": 99, "verdict": "different", "a": {"date": "1986", "phase": "point", "track": "ownership_structure", "section": 1, "text": "The London Fire and Civil Defence Authority was formed to take responsibility for the LFB."}, "b": {"date": "1986", "phase": "point", "track": "other", "section": 10, "text": "The Hampton Court fire was attended by both the LFB and Surrey Fire and Rescue Service."}}, {"id": "London_Fire_Brigade|16|17", "i": 16, "j": 17, "verdict": "different", "a": {"date": "2000", "phase": "point", "track": "ownership_structure", "section": 1, "text": "The LFCDA was replaced by the London Fire and Emergency Planning Authority."}, "b": {"date": "2000", "phase": "point", "track": "other", "section": 1, "text": "The Greater London Authority was established to administer the LFEPA."}}, {"id": "London_Fire_Brigade|18|105", "i": 18, "j": 105, "verdict": "different", "a": {"date": "2007", "phase": "point", "track": "location", "section": 1, "text": "The LFB vacated its Lambeth headquarters and moved to a site in Union Street, Southwark."}, "b": {"date": "2007-04", "phase": "point", "track": "other", "section": 10, "text": "The blaze in numerous shops on Oxford Street was a 30-pump fire."}}, {"id": "London_Fire_Brigade|19|101", "i": 19, "j": 101, "verdict": "different", "a": {"date": "2007", "phase": "point", "track": "role", "section": 1, "text": "LFB Commissioner Ken Knight was appointed as the first Chief Fire and Rescue Adviser to the government."}, "b": {"date": "2007", "phase": "point", "track": "other", "section": 10, "text": "The 2007 Cutty Sark fire required eight pumps."}}, {"id": "London_Fire_Brigade|20|64", "i": 20, "j": 64, "verdict": "same", "a": {"date": "2007", "phase": "start", "track": "role", "section": 1, "text": "Ron Dobson succeeded Knight as Commissioner."}, "b": {"date": "2007", "phase": "start", "track": "role", "section": 1, "text": "Ron Dobson took the role."}}, {"id": "London_Fire_Brigade|22|67", "i": 22, "j": 67, "verdict": "same", "a": {"date": "2020-01-01", "phase": "start", "track": "role", "section": 1, "text": "Andy Roe became commissioner of the LFB."}, "b": {"date": "2020", "phase": "start", "track": "role", "section": 1, "text": "Andy Roe took the role."}}, {"id": "London_Fire_Brigade|43|45", "i": 43, "j": 45, "verdict": "different", "a": {"date": "1941", "phase": "end", "track": "role", "section": 1, "text": "Cdr. Sir Aylmer Firebrace's term ended."}, "b": {"date": "1941", "phase": "end", "track": "role", "section": 1, "text": "Maj. Frank Jackson's term ended."}}, {"id": "London_Fire_Brigade|68|122", "i": 68, "j": 122, "verdict": "same", "a": {"date": "1965", "phase": "point", "track": "affiliation", "section": 2, "text": "The brigade was enlarged and took over almost all of the Middlesex Fire Brigade, part of west Kent, North Surrey and South West Essex, together with the small County Borough brigades of Croydon, East Ham and West Ham."}, "b": {"date": "1965", "phase": "point", "track": "affiliation", "section": 17, "text": "The LFB absorbed some stations from the county brigades."}}, {"id": "London_Fire_Brigade|68|123", "i": 68, "j": 123, "verdict": "same", "a": {"date": "1965", "phase": "point", "track": "affiliation", "section": 2, "text": "The brigade was enlarged and took over almost all of the Middlesex Fire Brigade, part of west Kent, North Surrey and South West Essex, together with the small County Borough brigades of Croydon, East Ham and West Ham."}, "b": {"date": "1965", "phase": "point", "track": "affiliation", "section": 17, "text": "M