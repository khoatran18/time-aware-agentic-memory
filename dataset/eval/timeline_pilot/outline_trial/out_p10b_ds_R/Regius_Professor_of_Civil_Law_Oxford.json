  },
  {
   "text": "Under statutes of 1549, the Regius Professor of Civil Law was to lecture four times a week.",
   "chunk": 1,
   "date_text": "1549",
   "date": "1549",
   "approximate": false,
   "track": "other",
   "phase": "point",
   "kind": "statement",
   "subject": "self",
   "object": "statutes of 1549",
   "quote": "Under statutes of 1549 , the Regius Professor of Civil Law was to lecture four times a week",
   "section": 1,
   "flags": [],
   "cid": "/wiki/Regius_Professor_of_Civil_Law_(Oxford)#1"
  },
  {
   "text": "The requirement to give four lectures a week was repeated in the statutes of 1564.",
   "chunk": 2,
   "date_text": "1564",
   "date": "1564",
   "approximate": false,
   "track": "other",
   "phase": "point",
   "kind": "statement",
   "subject": "self",
   "object": "statutes of 1564",
   "quote": "The requirement to give four lectures a week was repeated in the statutes of 1564",
   "section": 1,
   "flags": [],
   "cid": "/wiki/Regius_Professor_of_Civil_Law_(Oxford)#2"
  },
  {
   "text": "The requirement to give four lectures a week was repeated in the statutes of 1576.",
   "chunk": 2,
   "date_text": "1576",
   "date": "1576",
   "approximate": false,
   "track": "other",
   "phase": "point",
   "kind": "statement",
   "subject": "self",
   "object": "statutes",
