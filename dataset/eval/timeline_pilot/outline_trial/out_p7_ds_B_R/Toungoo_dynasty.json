   "date_text": "1613",
   "date": "1613",
   "approximate": false,
   "actor": "related",
   "actor_name": "Anaukpetlun",
   "section": 3,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#12"
  },
  {
