   "date_text": "1510",
   "date": "1510",
   "approximate": false,
   "actor": "subject",
   "actor_name": "King Mingyi Nyo",
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
   "text": "Inwa was conquered by the Mohnyin-led Shan sawbwas.",
