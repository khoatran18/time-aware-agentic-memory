 "events": [
  {
   "text": "The largest empire in the history of Southeast Asia collapsed in the 18 years following Bayinnaung's death.",
   "chunk": 1,
   "date_text": "1581",
   "date": "1581",
   "approximate": false,
   "actor": "subject",
   "actor_name": "Toungoo dynasty",
   "section": 0,
   "flags": [
    "name_not_in_page:Bayinnaung's"
   ],
   "cid": "/wiki/Toungoo_dynasty#1"
  },
  {
   "text": "Nyaungyan Min and his son Anaukpetlun succeeded in restoring a smaller, more manageable kingdom by 1622.",
   "chunk": 2,
   "date_text": "1622",
   "date": "1622",
   "approximate": true,
   "actor": "subject",
   "actor_name": "Nyaungyan Min and his son, Anaukpetlun",
   "section": 0,
   "flags": [
    "approximate_date"
   ],
   "cid": "/wiki/Toungoo_dynasty#2"
  },
  {
   "text": "Starting from the 1720s, the kingdom was beset with raids by the Meitei people of the Chindwin River, and a rebellion in Chiang Mai.",
   "chunk": 4,
   "date_text": "the 1720s",
   "date": null,
   "approximate": true,
   "actor": "subject",
   "actor_name": "the kingdom",
   "section": 0,
   "flags": [
    "approximate_date"
   ],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "Raids by the Meitei intensified in the 1730s, reaching increasingly deeper parts of central Burma.",
   "chunk": 4,
   "date_text": "the 1730s",
   "date": null,
   "approximate": true,
   "actor": "subject",
   "actor_name": "the kingdom",
   "section": 0,
   "flags": [
    "approximate_date"
   ],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "In 1740, the Mon people in Lower Burma began a rebellion, founding the Restored Hanthawaddy Kingdom.",
   "chunk": 4,
   "date_text": "1740",
   "date": "1740",
   "approximate": false,
   "actor": "other",
   "actor_name": "the Mon people in Lower Burma",
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "The Hanthawaddy armies captured Inwa in 1752 and ended the 266-year-old Toungoo dynasty.",
   "chunk": 4,
   "date_text": "1752",
   "date": "1752",
   "approximate": false,
   "actor": "related",
   "actor_name": "The Hanthawaddy armies",
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "King Mingyi Nyo founded the First Taungoo Dynasty at Taungoo.",
