  {
   "text": "The Toungoo rulers withdrew from southern Burma and founded a second dynasty at Ava, the Nyaungyan or Restored Taungoo Dynasty.",
   "chunk": 12,
   "date_text": "1597–1752",
   "date": "1597",
   "approximate": false,
   "actor": "subject",
   "actor_name": "Toungoo rulers",
   "section": 3,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#12"
  },
  {
   "text": "Anaukpetlun once again reunited Burma.",
   "chunk": 12,
   "date_text": "1613",
   "date": "1613",
   "approximate": false,
   "actor": "related",
   "actor_name": "Anaukpetlun",
   "section": 3,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#12"
  },
  {
   "text": "Anaukpetlun decisively defeated Portuguese attempts to take over Burma.",
