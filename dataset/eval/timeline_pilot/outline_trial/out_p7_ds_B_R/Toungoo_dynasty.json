   "date": "1527",
   "approximate": false,
   "actor": "other",
   "actor_name": "Mohnyin-led Shan sawbwas",
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
