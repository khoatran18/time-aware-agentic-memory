   "section": 1,
   "flags": [],
   "cid": "/wiki/National_Library_of_Serbia#2"
  },
  {
   "text": "The National Library moved into a building in the district of Kosančić Crescent.",
   "chunk": 2,
   "date_text": "1925",
   "date": "1925",
   "approximate": false,
   "track": "location",
   "phase": "point",
   "kind": "change",
