   "section": 1,
   "flags": [],
   "cid": "/wiki/National_Library_of_Serbia#1"
  },
  {
   "text": "The Library building and collections were damaged by bombing during World War I.",
   "chunk": 2,
   "date_text": "During World War I",
   "date": null,
   "approximate": false,
   "track": "other",
   "phase": "point",
   "kind": "occurrence",
   "subject": "self",
   "object": "Library building and collections",
   "quote": "During World War I , the Library building and collections were damaged by bombing",
   "section": 1,
   "flags": [],
   "cid": "/wiki/National_Library_of_Serbia#2"
  },
  {
   "text": "The remaining holdings were moved from Belgrade to Niš and Kragujevac for their protection.",
   "chunk": 2,
   "date_text": "During World War I",
   "date": null,
   "approximate": false,
   "track": "location",
   "phase": "point",
   "kind": "change",
