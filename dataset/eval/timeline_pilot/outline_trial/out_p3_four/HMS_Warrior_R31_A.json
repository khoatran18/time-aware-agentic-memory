{
 "events": [
  {
   "date": "1942",
   "text": "HMS Warrior was ordered by the British Royal Navy.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1945",
   "text": "Construction of HMS Warrior was finished.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1946",
   "text": "The aircraft carrier was loaned to the Royal Canadian Navy.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1948",
   "text": "The loan to the Royal Canadian Navy ended.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1948",
   "text": "Warrior was returned to the Royal Navy and entered service.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1956",
   "text": "An angled flight deck was installed on the ship.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1948-1949",
   "text": "The ship was used in aircraft landing experiments.",
   "chunk": 0,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#0"
  },
  {
   "date": "1957",
   "text": "The ship was used as the headquarters ship during nuclear testing at Christmas Island.",
   "chunk": 1,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#1"
  },
  {
   "date": "1958",
   "text": "The vessel was sold to the Argentine Navy.",
   "chunk": 1,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#1"
  },
  {
   "date": "1959",
   "text": "The ship entered Argentine service as ARA Independencia.",
   "chunk": 1,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#1"
  },
  {
   "date": "1970",
   "text": "Independencia was placed in reserve.",
   "chunk": 1,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#1"
  },
  {
   "date": "1971",
   "text": "The ship was sold for scrap.",
   "chunk": 1,
   "section": 0,
   "cid": "/wiki/HMS_Warrior_(R31)#1"
  },
  {
   "date": null,
   "text": "Warrior had a standard displacement of when built.",
   "chunk": 2,
   "section": 1,
   "cid": "/wiki/HMS_Warrior_(R31)#2"
  },
  {
   "date": "1942-08-07",
   "text": "The contract to construct Warrior was placed.",
   "chunk": 9,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#9"
  },
  {
   "date": "1942-12-12",
   "text": "The keel of the ship was laid down.",
   "chunk": 9,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#9"
  },
  {
   "date": "1944-05-20",
   "text": "The aircraft carrier was launched.",
   "chunk": 9,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#9"
  },
  {
   "date": "1944-05",
   "text": "Planning began for the Royal Canadian Navy to require a larger fleet.",
   "chunk": 11,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#11"
  },
  {
   "date": "1945-04",
   "text": "Negotiations were finalised for the loan of Warrior.",
   "chunk": 11,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#11"
  },
  {
   "date": "1945-05",
   "text": "Negotiations were completed for the naval air squadrons needed to man the aircraft carrier.",
   "chunk": 12,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#12"
  },
  {
   "date": "1946-01-24",
   "text": "Warrior was completed, transferred to the RCN and commissioned as HMCS Warrior.",
   "chunk": 13,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#13"
  },
  {
   "date": "1946-03",
   "text": "Sea trials were completed.",
   "chunk": 13,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#13"
  },
  {
   "date": "1946-03-23",
   "text": "Warrior officially joined the Canadian Atlantic Fleet.",
   "chunk": 15,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#15"
  },
  {
   "date": "1946-03-31",
   "text": "Warrior entered Halifax harbour.",
   "chunk": 15,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#15"
  },
  {
   "date": "1946-08",
   "text": "The aircraft carrier had its first loss when a Firefly ditched.",
   "chunk": 15,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#15"
  },
  {
   "date": "1946-08-23",
   "text": "Warrior ran aground at Pointe Sainte Antoine.",
   "chunk": 15,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#15"
  },
  {
   "date": "1946-08-23",
   "text": "Tugboats got the aircraft carrier unstuck from the mud bank.",
   "chunk": 16,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#16"
  },
  {
   "date": "1946-11",
   "text": "The ship was transferred west to Esquimalt, British Columbia.",
   "chunk": 17,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#17"
  },
  {
   "date": "1946-12",
   "text": "Warrior arrived in Esquimalt.",
   "chunk": 17,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#17"
  },
  {
   "date": "1947-01-18",
   "text": "Commodore Harry DeWolf took command of Warrior.",
   "chunk": 17,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#17"
  },
  {
   "date": "1947-01-31",
   "text": "One 825 Squadrons Fireflys was lost off Portland Island.",
   "chunk": 17,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#17"
  },
  {
   "date": "1947-02",
   "text": "The aircraft carrier began her voyage back to Halifax.",
   "chunk": 18,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#18"
  },
  {
   "date": "1947-03-27",
   "text": "Warrior returned to Halifax.",
   "chunk": 19,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#19"
  },
  {
   "date": "1947-08",
   "text": "Warrior sailed for the United Kingdom to be re-equipped.",
   "chunk": 19,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#19"
  },
  {
   "date": "1947-08-28",
   "text": "Warrior returned to Halifax.",
   "chunk": 19,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#19"
  },
  {
   "date": "1947-11",
   "text": "Magnificents air group trained aboard Warrior.",
   "chunk": 20,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#20"
  },
  {
   "date": "1948-02-12",
   "text": "The ship sailed for the UK.",
   "chunk": 20,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#20"
  },
  {
   "date": "1948-02-20",
   "text": "The ship arrived at Belfast.",
   "chunk": 20,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#20"
  },
  {
   "date": "1948-03-01",
   "text": "The ship moved to Spithead.",
   "chunk": 20,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#20"
  },
  {
   "date": "1948-03-23",
   "text": "Warrior was returned to the Royal Navy at Portsmouth.",
   "chunk": 21,
   "section": 2,
   "cid": "/wiki/HMS_Warrior_(R31)#21"
  },
  {
   "date": "1948-03-23",
   "text": "HMCS Warrior was recommissioned as HMS Warrior.",
   "chunk": 22,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#22"
  },
  {
   "date": "1948-11",
   "text": "Trials of the flexible flight deck began.",
   "chunk": 23,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#23"
  },
  {
   "date": "1949-03",
   "text": "Trials of the flexible flight deck were completed and the ship was paid off into the reserve at Portsmouth.",
   "chunk": 23,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#23"
  },
  {
   "date": "1950-06",
   "text": "Warrior was reactivated.",
   "chunk": 24,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#24"
  },
  {
   "date": "1950-08",
   "text": "Warrior departed on a mission to carry troops and aircraft to the Far East.",
   "chunk": 24,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#24"
  },
  {
   "date": "1951-06",
   "text": "Warrior sailed to Cyprus with 16 Parachute Brigade embarked.",
   "chunk": 24,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#24"
  },
  {
   "date": "1952",
   "text": "The ship underwent refit at Devonport Dockyard.",
   "chunk": 24,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#24"
  },
  {
   "date": "1953",
   "text": "The ship underwent refit at Devonport Dockyard.",
   "chunk": 24,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#24"
  },
  {
   "date": "1954",
   "text": "Warrior was deployed to the Far East to patrol off the coast of Korea.",
   "chunk": 25,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#25"
  },
  {
   "date": "1954-09",
   "text": "The ship evacuated refugees from Haiphong to Vung Tau.",
   "chunk": 25,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#25"
  },
  {
   "date": "1955",
   "text": "A refit was carried out at Devonport to install an angled flight deck.",
   "chunk": 27,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#27"
  },
  {
   "date": "1958-02",
   "text": "The Royal Navy decommissioned Warrior.",
   "chunk": 29,
   "section": 3,
   "cid": "/wiki/HMS_Warrior_(R31)#29"
  },
  {
   "date": "1958",
   "text": "Warrior was sold to Argentina.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1958-08-06",
   "text": "Warrior was renamed ARA Independencia.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1958-11-04",
   "text": "The Argentinian naval ensign was raised at Portsmouth.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1958-12-10",
   "text": "The ship sailed for Argentina.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1959-06-08",
   "text": "Argentine Naval Aviation began air operations from Independencia.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1959-07-08",
   "text": "The ship was commissioned into the Argentine Navy.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1962-05",
   "text": "The ship was provided with one quadruple and nine double mountings of 40 mm guns.",
   "chunk": 31,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#31"
  },
  {
   "date": "1963-08",
   "text": "Grumman F9F Panther jet fighters began launching from Independencia.",
   "chunk": 33,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#33"
  },
  {
   "date": "1969",
   "text": "The aircraft carrier entered service.",
   "chunk": 33,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#33"
  },
  {
   "date": "1970",
   "text": "Independencia moved to the reserve.",
   "chunk": 34,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#34"
  },
  {
   "date": "1971",
   "text": "The ship was scrapped.",
   "chunk": 34,
   "section": 4,
   "cid": "/wiki/HMS_Warrior_(R31)#34"
  }
