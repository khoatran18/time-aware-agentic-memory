   "date_text": "since 2005",
   "date": "2005",
   "approximate": false,
   "actor": "subject",
   "actor_name": "Higgins",
   "section": 0,
   "flags": [],
   "cid": "/wiki/Brian_Higgins#0"
  },
  {
   "text": "Higgins served on the Buffalo Common Council from 1988 to 1993.",
   "chunk": 2,
   "date_text": "1988",
   "date": "1988",
   "approximate": false,
   "actor": "subject",
   "actor_name": "Higgins",
   "section": 0,
   "flags": [],
   "cid": "/wiki/Brian_Higgins#2"
  },
  {
