   "date_text": "1597–1752",
   "date": "1597",
   "approximate": false,
   "section": 3,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#12"
  },
  {
   "text": "The Nyaungyan or Restored Taungoo Dynasty ended.",
   "chunk": 12,
   "date_text": "1597–1752",
   "date": "1752",
   "approximate": false,
   "section": 3,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#12"
  },
  {
   "text": "Anaukpetlun once again reunited Burma.",
