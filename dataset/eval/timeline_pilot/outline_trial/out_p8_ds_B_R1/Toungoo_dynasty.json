 "events": [
  {
   "text": "The Toungoo Empire collapsed in the 18 years following Bayinnaung's death.",
   "chunk": 1,
   "date_text": "1581",
   "date": "1581",
   "approximate": false,
   "section": 0,
   "flags": [
    "name_not_in_page:Bayinnaung's"
   ],
   "cid": "/wiki/Toungoo_dynasty#1"
  },
  {
   "text": "Nyaungyan Min and his son Anaukpetlun succeeded in restoring a smaller kingdom encompassing Lower Burma, Upper Burma, Shan States and Lan Na.",
   "chunk": 2,
   "date_text": "by 1622",
   "date": "1622",
   "approximate": true,
   "section": 0,
   "flags": [
    "approximate_date"
   ],
   "cid": "/wiki/Toungoo_dynasty#2"
  },
  {
   "text": "The kingdom was beset with raids by the Meitei people of the Chindwin River and a rebellion in Chiang Mai.",
   "chunk": 4,
   "date_text": "the 1720s",
   "date": null,
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "Raids by the Meitei intensified, reaching increasingly deeper parts of central Burma.",
   "chunk": 4,
   "date_text": "the 1730s",
   "date": null,
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "The Mon people in Lower Burma began a rebellion, founding the Restored Hanthawaddy Kingdom.",
   "chunk": 4,
   "date_text": "1740",
   "date": "1740",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "The Hanthawaddy armies captured Inwa and ended the 266-year-old Toungoo dynasty.",
   "chunk": 4,
   "date_text": "1752",
   "date": "1752",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#4"
  },
  {
   "text": "King Mingyi Nyo founded the First Taungoo Dynasty.",
   "chunk": 5,
   "date_text": "1485",
   "date": "1485",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
   "text": "The First Taungoo Dynasty ended.",
   "chunk": 5,
   "date_text": "1599",
   "date": "1599",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
   "text": "King Mingyi Nyo founded the First Taungoo Dynasty at Taungoo towards the end of the Ava Kingdom.",
   "chunk": 5,
   "date_text": "1510",
   "date": "1510",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
   "text": "Inwa was conquered by the Mohnyin-led Shan sawbwas.",
   "chunk": 5,
   "date_text": "1527",
   "date": "1527",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#5"
  },
  {
   "text": "Tabinshwehti was crowned as king of all Burma at Bagan.",
   "chunk": 6,
   "date_text": "1544",
   "date": "1544",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#6"
  },
  {
   "text": "Tabinshwehti was defeated in the Burmese–Siamese War.",
   "chunk": 8,
   "date_text": "1547",
   "date": "1547",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Toungoo_dynasty#8"
  },
  {
   "text": "Tabinshwehti was assassinated.",
