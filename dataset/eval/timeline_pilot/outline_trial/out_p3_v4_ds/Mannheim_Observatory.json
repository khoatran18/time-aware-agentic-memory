{
 "events": [
  {
   "text": "The Mannheim Observatory was built in Mannheim, Germany.",
   "chunk": 0,
   "date_text": "1772",
   "date": "1772",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The Mannheim Observatory was built in Mannheim, Germany.",
   "chunk": 0,
   "date_text": "1774",
   "date": "1774",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The observatory remained in operation until 1880.",
   "chunk": 0,
   "date_text": "1880",
   "date": "1880",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The observatory was transferred to Karlsruhe.",
   "chunk": 0,
   "date_text": null,
   "date": null,
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The observatory was established on the Königstuhl near Heidelberg.",
   "chunk": 0,
   "date_text": "1898",
   "date": "1898",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The observatory tower was restored.",
   "chunk": 0,
   "date_text": "1905–1906",
   "date": "1905",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The observatory tower was restored after the Second World War.",
   "chunk": 0,
   "date_text": "after the Second World War",
   "date": null,
   "approximate": true,
   "section": 0,
   "flags": [
    "approximate_date"
   ],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The tower houses studio flats.",
   "chunk": 0,
   "date_text": "1958",
   "date": "1958",
   "approximate": false,
   "section": 0,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#0"
  },
  {
   "text": "The Physics Institute was established in Heidelberg.",
   "chunk": 1,
   "date_text": "1751",
   "date": "1751",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#1"
  },
  {
   "text": "Mayer was sent to Paris to study the local water supply.",
   "chunk": 2,
   "date_text": "1756",
   "date": "1756",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#2"
  },
  {
   "text": "Mayer observed the return of the comet predicted by Edmond Halley.",
   "chunk": 2,
   "date_text": "1759",
   "date": "1759",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#2"
  },
  {
   "text": "Mayer observed the Transit of Venus across the Sun from a temporary Observatory built of wood by Karl Theodor in the Orangery in the park of Schwetzingen Castle.",
   "chunk": 3,
   "date_text": "6 June 1761",
   "date": "1761-06-06",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#3"
  },
  {
   "text": "The observations convinced the elector as early as July to begin work on an observatory building on the palace roof.",
   "chunk": 3,
   "date_text": "July",
   "date": null,
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#3"
  },
  {
   "text": "The observatory building on the palace roof was inaugurated.",
   "chunk": 3,
   "date_text": "1764",
   "date": "1764",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#3"
  },
  {
   "text": "Mayer travelled for a year to St. Petersburg and observed there another Transit of Venus.",
   "chunk": 4,
   "date_text": "3 June 1769",
   "date": "1769-06-03",
   "approximate": false,
   "section": 1,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#4"
  },
  {
   "text": "Mayer presented a memorandum on the construction of an observatory to the Mannheim Court.",
   "chunk": 6,
   "date_text": "New Years Day 1771",
   "date": "1771",
   "approximate": false,
   "section": 2,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#6"
  },
  {
   "text": "The Elector charged the Court Chamberlain with the construction of the observatory.",
   "chunk": 6,
   "date_text": "1772",
   "date": "1772",
   "approximate": false,
   "section": 2,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#6"
  },
  {
   "text": "The foundation stone of the tower next to Schloss Mannheim was laid.",
   "chunk": 6,
   "date_text": "In the same year",
   "date": "1772",
   "approximate": false,
   "section": 2,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#6"
  },
  {
   "text": "Elector Karl Theodor left the Palatinate to govern Bavaria.",
   "chunk": 8,
   "date_text": "1778",
   "date": "1778",
   "approximate": false,
   "section": 2,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#8"
  },
  {
   "text": "Christian Mayer died.",
   "chunk": 8,
   "date_text": "1783",
   "date": "1783",
   "approximate": false,
   "section": 2,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#8"
  },
  {
   "text": "John Fischer resigned after only a year and a half.",
   "chunk": 9,
   "date_text": "1788",
   "date": "1788",
   "approximate": false,
   "section": 3,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#9"
  },
  {
   "text": "Peter Ungeschick died on the return journey from studying in Paris.",
   "chunk": 9,
   "date_text": "1790",
   "date": "1790",
   "approximate": false,
   "section": 3,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#9"
  },
  {
   "text": "Roger Barry recommenced his observations.",
   "chunk": 11,
   "date_text": "1806",
   "date": "1806",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#11"
  },
  {
   "text": "Roger Barry fell ill.",
   "chunk": 11,
   "date_text": "1810",
   "date": "1810",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#11"
  },
  {
   "text": "Roger Barry died.",
   "chunk": 11,
   "date_text": "1813",
   "date": "1813",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#11"
  },
  {
   "text": "The observatory declined in the years up to the Baden Revolution.",
   "chunk": 12,
   "date_text": "1848",
   "date": "1848",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#12"
  },
  {
   "text": "Heinrich Christian Schumacher was Director.",
   "chunk": 12,
   "date_text": "1813–1815",
   "date": "1813",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#12"
  },
  {
   "text": "Bernhard Nicolai became Court Astronomer.",
   "chunk": 12,
   "date_text": "1816",
   "date": "1816",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#12"
  },
  {
   "text": "Bernhard Nicolai died.",
   "chunk": 12,
   "date_text": "1846",
   "date": "1846",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#12"
  },
  {
   "text": "It was decided to end the Institute by appointing no new Court Astronomer.",
   "chunk": 14,
   "date_text": "10 June 1850",
   "date": "1850-06-10",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#14"
  },
  {
   "text": "The Heidelberg professor Nell took over the unpaid supervision of the institute.",
   "chunk": 14,
   "date_text": "1852",
   "date": "1852",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#14"
  },
  {
   "text": "The institute planned renewal with the purchase of a six-stage telescope.",
   "chunk": 14,
   "date_text": "1859",
   "date": "1859",
   "approximate": false,
   "section": 4,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#14"
  },
  {
   "text": "Eduard Schönfeld was appointed Director.",
   "chunk": 15,
   "date_text": "In 1859",
   "date": "1859",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#15"
  },
  {
   "text": "Schönfeld left for Bonn.",
   "chunk": 18,
   "date_text": "1875",
   "date": "1875",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#18"
  },
  {
   "text": "Karl Wilhelm Valentiner took over the Mannheim Directorship.",
   "chunk": 18,
   "date_text": "1875",
   "date": "1875",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#18"
  },
  {
   "text": "The Observatory was moved to a makeshift building in Karlsruhe.",
   "chunk": 18,
   "date_text": "1880",
   "date": "1880",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#18"
  },
  {
   "text": "Max Wolf had already built a private observatory in his parents house.",
   "chunk": 19,
   "date_text": "1880",
   "date": "1880",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#19"
  },
  {
   "text": "A deputation of Heidelberg professors petitioned the Grand Duke of Karlsruhe for a University research and teaching observatory.",
   "chunk": 20,
   "date_text": "In 1892",
   "date": "1892",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#20"
  },
  {
   "text": "The Großherzogliche Bergsternwarte at Königstuhl was ceremonially inaugurated by Frederick I, Grand Duke of Baden.",
   "chunk": 22,
   "date_text": "20 June 1898",
   "date": "1898-06-20",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#22"
  },
  {
   "text": "Valentiner retired.",
   "chunk": 22,
   "date_text": "1909",
   "date": "1909",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#22"
  },
  {
   "text": "The Mannheim instruments were donated to the State Museum of Technology and Industry in Mannheim.",
   "chunk": 25,
   "date_text": "In 1983",
   "date": "1983",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#25"
  },
  {
   "text": "The 1859 six-stage telescope was given to the city of Karlsruhe for the establishment of the Public Astronomical Observatory of Karlsruhe.",
   "chunk": 25,
   "date_text": "in 1957",
   "date": "1957",
   "approximate": false,
   "section": 5,
   "flags": [],
   "cid": "/wiki/Mannheim_Observatory#25"
  }
 ],
 "dropped": []
}